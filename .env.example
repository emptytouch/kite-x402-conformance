# ---------------------------------------------------------------------------
# kite-x402-conformance — example configuration
#
# Copy to .env and fill in. NEVER commit a real .env or a private key.
# Nothing here is required for dry-run checks: without a key the tool only
# inspects challenges and never signs or sends a transaction.
# ---------------------------------------------------------------------------

# Network to enforce. testnet = eip155:2368, mainnet = eip155:2366.
KITE_NETWORK=testnet

# RPC endpoint. Leave empty to use the built-in testnet default.
KITE_RPC_URL=

# Facilitator base URL. Leave empty to skip facilitator-dependent checks.
KITE_FACILITATOR_URL=

# Settlement asset address (USDT / pieUSD). Required for amount-level checks.
KITE_ASSET_ADDRESS=

# Receiver wallet that challenges must pay to. Optional: when set, C2 fails if
# the advertised payTo does not match.
KITE_EXPECTED_PAY_TO=

# RESERVED — not read by any code in 0.1.0. The opt-in live mode (`--pay`) is
# not implemented yet. When it lands, this key will be read from the environment
# only: never written to disk, never logged, never included in reports.
KITE_PAYER_PRIVATE_KEY=
